<!-- 我的事 tab：hero 发起入口 + 进行中列表（投票/收集/待办聚合，微信官方组件） -->
<view class="page">
  <view class="hero">
    <view class="hero-eyebrow">下一件事，先把时间凑齐</view>
    <view class="hero-title">发起投票</view>
    <view class="hero-desc">选好时间发到群里，大家点开就能参与。</view>
    <button class="hero-btn" bindtap="goCreate">30 秒发起一场 →</button>
  </view>

  <view class="section-head">
    <text>一件事的全流程</text>
    <text class="sub">点开接着办</text>
  </view>
  <view class="chain">
    <button class="chain-btn active" data-step="vote" bindtap="goChain"><text class="ico">🗳️</text><text class="lbl">凑时间</text></button>
    <button class="chain-btn" data-step="todo" bindtap="goChain"><text class="ico">✅</text><text class="lbl">凑分工</text></button>
    <button class="chain-btn" data-step="calendar" bindtap="goChain"><text class="ico">📅</text><text class="lbl">沉淀</text></button>
    <button class="chain-btn" data-step="group" bindtap="goChain"><text class="ico">🧩</text><text class="lbl">群资产</text></button>
  </view>

  <view class="section-head">
    <text>进行中的活动</text>
    <text class="sub">{{items.length}} 场</text>
  </view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{items.length === 0}}" class="empty">还没有进行中的活动\n从群里点开一张卡片，就能参与</view>
  <button
    wx:for="{{items}}"
    wx:key="uid"
    class="activity"
    data-kind="{{item.kind}}"
    data-ref="{{item.refId}}"
    bindtap="openActivity"
  >
    <view class="activity-body">
      <view class="activity-title">{{item.title}}</view>
      <view class="activity-sub" wx:if="{{item.kind === 'VOTE'}}">{{item.myRole === 'OWNER' ? '我发起的 · ' : ''}}已投 {{item.voterCount}} 人</view>
      <view class="activity-sub" wx:elif="{{item.kind === 'COLLECT'}}">{{item.myRole === 'OWNER' ? '我发起的 · ' : ''}}已填 {{item.filledCount}} 人</view>
      <view class="activity-sub" wx:else>{{item.myRole === 'OWNER' ? '我发起的 · ' : ''}}{{item.summary.done}}/{{item.summary.total}} 件事搞定</view>
    </view>
    <view class="activity-status" wx:if="{{item.kind === 'VOTE'}}">{{item.status === 'OPEN' ? '去投票' : '已定档'}}</view>
    <view class="activity-status" wx:elif="{{item.kind === 'COLLECT'}}">{{item.status === 'OPEN' ? '去填表' : '已收表'}}</view>
    <view class="activity-status" wx:else>{{item.status === 'OPEN' ? '搭把手' : '全办成了'}}</view>
  </button>
</view>
