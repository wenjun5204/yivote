.page { padding: 24rpx 32rpx 160rpx; }
.hero {
  padding: 48rpx 40rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0e5937, #18794e);
  color: #fff;
}
.hero-eyebrow { font-size: 24rpx; opacity: .85; letter-spacing: 4rpx; }
.hero-title { font-size: 50rpx; font-weight: 800; margin: 16rpx 0 8rpx; }
.hero-desc { font-size: 26rpx; color: #d1ebd9; }
.hero-btn {
  margin-top: 34rpx;
  background: #fff;
  color: #0e5937;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 22rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 42rpx 4rpx 18rpx;
  font-weight: 700;
}
.section-head .sub { font-size: 22rpx; color: #667067; font-weight: 400; }
.chain {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6rpx;
  padding: 24rpx 16rpx;
  background: #fff;
  border: 1rpx solid #dce3da;
  border-radius: 30rpx;
}
.chain-btn {
  padding: 10rpx 2rpx;
  background: transparent;
  line-height: 1.5;
  font-size: 20rpx;
  color: #667067;
  border: 0;
}
.chain-btn::after { border: 0; }
.chain-btn .ico { display: block; font-size: 38rpx; }
.chain-btn .lbl { display: block; color: #172019; font-size: 22rpx; margin-top: 4rpx; }
.chain-btn.active .lbl { color: #0e5937; font-weight: 700; }
.empty { text-align: center; color: #667067; font-size: 26rpx; padding: 60rpx 0; }
.activity {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid #dce3da;
  border-radius: 30rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  text-align: left;
}
.activity-body { flex: 1; }
.activity-title { font-size: 30rpx; font-weight: 700; }
.activity-sub { font-size: 22rpx; color: #667067; margin-top: 8rpx; }
.activity-status { color: #18794e; font-size: 24rpx; font-weight: 700; }
