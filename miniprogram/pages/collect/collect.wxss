.page { padding: 28rpx 36rpx 240rpx; }
.loading { text-align: center; color: #667067; padding: 200rpx 0; }
.context { display: flex; align-items: center; gap: 18rpx; color: #667067; font-size: 24rpx; }
.avatar { width: 54rpx; height: 54rpx; border-radius: 50%; background: #e8e4ff; color: #5943a6; display: flex; align-items: center; justify-content: center; font-weight: 800; }
.vtitle { font-size: 46rpx; font-weight: 800; margin: 28rpx 0 20rpx; }
.status-card { border: 2rpx solid #b7dbc2; border-radius: 28rpx; padding: 24rpx 28rpx; background: linear-gradient(120deg, #f2fbf4, #fffdf0); font-size: 26rpx; }
.status-top { display: flex; justify-content: space-between; }
.strong { color: #0e5937; font-weight: 800; }
.form-card { background: #fff; border: 3rpx solid #dce3da; border-radius: 28rpx; padding: 28rpx; margin-top: 24rpx; }
.f-row { margin-bottom: 26rpx; }
.f-row:last-child { margin-bottom: 0; }
.f-label { font-size: 24rpx; color: #667067; font-weight: 700; margin-bottom: 14rpx; }
.f-input { border: 3rpx solid #dce3da; border-radius: 20rpx; padding: 20rpx; font-size: 30rpx; background: #fbfdfb; }
.size-chips { display: flex; gap: 14rpx; }
.chip { flex: 1; background: #fff; border: 3rpx solid #dce3da; border-radius: 20rpx; font-size: 28rpx; padding: 16rpx 0; margin: 0; }
.chip.sel { border-color: #18794e; background: #e5f4e9; font-weight: 800; color: #0e5937; }
.receipt { font-size: 26rpx; color: #172019; line-height: 2; }
.btn-secondary { background: #fff; color: #0e5937; border: 3rpx solid #18794e; border-radius: 24rpx; font-size: 28rpx; font-weight: 700; margin-top: 24rpx; }
.entry-row { display: flex; align-items: center; gap: 14rpx; background: #fff; border: 2rpx solid #dce3da; border-radius: 22rpx; padding: 22rpx; margin-top: 18rpx; font-size: 26rpx; }
.face { width: 44rpx; height: 44rpx; border-radius: 50%; background: #dbeef9; color: #216785; display: inline-flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 800; }
.entry-name { font-weight: 700; }
.entry-vals { flex: 1; color: #667067; font-size: 24rpx; }
.tag-done { background: #e5f4e9; color: #0e5937; font-size: 20rpx; font-weight: 800; border-radius: 10rpx; padding: 4rpx 12rpx; }
.main-btn {
  position: fixed; left: 36rpx; right: 36rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #18794e; color: #fff; font-size: 34rpx; font-weight: 800; border-radius: 28rpx;
  box-shadow: 0 16rpx 28rpx rgba(24, 121, 78, .22);
}
.main-btn[disabled] { background: #e4e9e4; color: #94a098; box-shadow: none; }
