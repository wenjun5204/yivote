<!-- 投票详情：分享卡片直达页（≤2 次点击完成投票，零键盘） -->
<view class="page" wx:if="{{vote}}">
  <view class="context">
    <view class="avatar">{{vote.owner.nickname[0] || '友'}}</view>
    <text>{{vote.owner.nickname}}发起 · 点亮你有空的时间</text>
  </view>
  <view class="vtitle">{{vote.title}}</view>

  <view class="status-card">
    <view class="status-top">
      <text>已投 <text class="strong">{{voterCount}}</text> 人</text>
      <text wx:if="{{bestLabel}}" class="lead">{{bestLabel}}最多人有空</text>
    </view>
    <view class="progress"><view class="fill" style="width: {{progress}}%"></view></view>
  </view>

  <block wx:if="{{vote.status === 'OPEN'}}">
    <view class="slot" wx:for="{{vote.slots}}" wx:key="slotId"
      data-id="{{item.slotId}}" bindtap="toggle" style="{{item.picked ? 'border-color:#18794e;background:#e5f4e9' : ''}}">
      <view class="slot-top">
        <text class="slot-name">{{item.label}}</text>
        <text class="slot-count">{{item.count}} 人</text>
        <text wx:if="{{item.isBest}}" class="best-tag">最多人有空</text>
      </view>
      <view class="faces">
        <text class="face" wx:for="{{item.voters}}" wx:for-item="v" wx:key="userId" wx:if="{{index < 5}}">{{v.nickname[0]}}</text>
        <text wx:if="{{item.count > 5}}" class="more">+{{item.count - 5}}</text>
      </view>
    </view>

    <!-- 提交后 feedback 卡:已记下您的时间,档期变了随时改 -->
    <view wx:if="{{submitted}}" class="feedback">
      <text class="feedback-check">✓</text>
      <text>已记下您的时间：{{feedbackLabels}}。档期变了可以随时修改。</text>
    </view>
    <view wx:else class="tips">选完点下面按钮就记上了，截止前随时能改</view>
  </block>

  <block wx:else>
    <!-- 已定档:对照原型 result 屏(stamp 定 + 到场名单 + 双 CTA 在底部) -->
    <view class="result">
      <view class="stamp">定</view>
      <view class="result-h">这场定了！</view>
      <view class="result-p">{{lockedLabel}} · {{vote.owner.nickname}}组织\n一起把这场张罗成。</view>
    </view>
    <view class="roster-card">
      <view class="roster-head">到场名单 · {{lockedCount}} 人</view>
      <view class="roster">
        <view class="person" wx:for="{{lockedVoters}}" wx:key="userId">
          <text class="face big">{{item.nickname[0]}}</text>
          <text>{{item.nickname}}</text>
        </view>
      </view>
      <view class="roster-note">这份名单会留在活动里，接下来可以直接分工。</view>
    </view>
    <view wx:if="{{fromGid}}" class="cal-entry" bindtap="goCalendar">
      <text class="cal-ico">📅</text>
      <text class="cal-txt">这场已写进群日历，看看这个群还约过什么</text>
      <text class="arrow">›</text>
    </view>
  </block>
</view>
<view class="page" wx:else>
  <view class="loading">正在打开投票…</view>
</view>

<!-- 群友视角:提交前=确认按钮 / 提交后=改投 -->
<button wx:if="{{vote && vote.status === 'OPEN' && !isOwner && !submitted}}" class="main-btn" disabled="{{!picked.length}}" bindtap="submit">
  就这些时间我有空
</button>
<button wx:if="{{vote && vote.status === 'OPEN' && !isOwner && submitted}}" class="main-btn ghost" bindtap="editVote">
  改一下我的时间
</button>
<!-- 组织者视角:进定档确认页(最优时段 + 到场名单) -->
<button wx:if="{{vote && vote.status === 'OPEN' && isOwner}}" class="main-btn" bindtap="goDecision">
  定 {{bestLabel}}
</button>
<!-- 已定档:结果卡转发(官方 open-type=share) + 用名单分个工 -->
<button wx:if="{{vote && vote.status === 'LOCKED'}}" class="main-btn" open-type="share">
  把定档结果发到群里
</button>
<button wx:if="{{vote && vote.status === 'LOCKED' && isOwner}}" class="main-btn ghost second-cta" bindtap="goTodo">
  用这份名单分个工
</button>
